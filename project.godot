[application]

config/name="Valorant 2D"
config/version="0.2.5"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

NetworkManager="*res://scripts/network/network_manager.gd"
AudioManager="*res://scenes/audio/audio_manager.tscn"
GameUpdateBootstrap="*res://scripts/systems/game_update_bootstrap.gd"

[debug]

shapes/collision/draw=true

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_group]

updraft_traversable="Objects Jett can pass through while Updraft is active."
bullet_penetrable="Objects bullets can penetrate."

